client
dev tun
proto {{ openvpn_proto }}
remote {{ ansible_host }} {{ openvpn_port }}
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
auth SHA256
cipher AES-256-GCM
key-direction 1
verb 3
<ca>
{{ ca_b64 }}
</ca>
<cert>
{{ cert_b64 }}
</cert>
<key>
{{ key_b64 }}
</key>
<tls-auth>
{{ ta_b64 }}
</tls-auth>
auth-user-pass
auth-nocache