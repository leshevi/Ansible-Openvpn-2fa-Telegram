port {{ openvpn_port }}
proto {{ openvpn_proto }}
dev tun
ca ca.crt
cert server.crt
key server.key
dh dh.pem
tls-auth ta.key 0
crl-verify crl.pem
server {{ openvpn_network }} {{ openvpn_mask }}
topology subnet
push "redirect-gateway def1 bypass-dhcp"
push "dhcp-option DNS 10.8.0.1"
keepalive 10 120
auth SHA256
cipher AES-256-GCM
user nobody
group nogroup
persist-key
persist-tun
verb 3